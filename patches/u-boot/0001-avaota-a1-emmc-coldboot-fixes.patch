+		if (IS_ENABLED(CONFIG_MACH_SUN55I_A523) && IS_MMC(mmc)) {
+			printf("LYNX_MMC_FORCE_USER: mode=%u before_part_config=0x%02x cached_hwpart=%u\n",
+			       boot_mode, mmc->part_config,
