@@ -413,6 +416,31 @@ int spl_mmc_load(struct spl_image_info *spl_image,
 	case MMCSD_MODE_RAW:
 		debug("spl: mmc boot mode: raw\n");
 
+		/*
+		 * A523/T527 reports raw boot mode even when BootROM fetched SPL from
+		 * eMMC Boot0.  The controller still accesses Boot0, but the legacy
+		 * block descriptor is cached as hwpart 0.  A no-op CMD6 value of zero
