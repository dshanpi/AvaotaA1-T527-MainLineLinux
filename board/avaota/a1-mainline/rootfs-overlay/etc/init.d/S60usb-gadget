#!/bin/sh

case "$1" in
  start)
    modprobe libcomposite 2>/dev/null || true
    mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
    gadget=/sys/kernel/config/usb_gadget/avaota_a1
    [ -d "$gadget" ] && exit 0
    mkdir -p "$gadget"
    echo 0x1d6b > "$gadget/idVendor"
    echo 0x0104 > "$gadget/idProduct"
    mkdir -p "$gadget/strings/0x409"
    echo A1MAINLINE2026 > "$gadget/strings/0x409/serialnumber"
    echo AvaotaSBC > "$gadget/strings/0x409/manufacturer"
    echo "Avaota A1 ACM ECM" > "$gadget/strings/0x409/product"
    mkdir -p "$gadget/configs/c.1/strings/0x409"
    echo "Serial and Ethernet" > "$gadget/configs/c.1/strings/0x409/configuration"
    mkdir -p "$gadget/functions/acm.usb0" "$gadget/functions/ecm.usb0"
    echo 02:00:00:52:70:01 > "$gadget/functions/ecm.usb0/dev_addr"
    echo 02:00:00:52:70:02 > "$gadget/functions/ecm.usb0/host_addr"
    ln -s "$gadget/functions/acm.usb0" "$gadget/configs/c.1/"
    ln -s "$gadget/functions/ecm.usb0" "$gadget/configs/c.1/"
    udc="$(ls /sys/class/udc 2>/dev/null | head -n 1)"
    [ -n "$udc" ] && echo "$udc" > "$gadget/UDC"
    ;;
  stop)
    gadget=/sys/kernel/config/usb_gadget/avaota_a1
    [ -d "$gadget" ] && echo "" > "$gadget/UDC"
    ;;
esac

exit 0
